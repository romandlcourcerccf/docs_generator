    "from pathlib import Path\n",
    "from typing import Any\n",
    "\n",
    "import json\n",
    "\n",
    "def generate_image(path_to_folder:str, writng_info: Any, gen_number: int):\n",
    "\n",
    "    source_folder = 'source'\n",
    "    target_folder = 'target'\n",
    "\n",
    "    image_file = writng_info['file_upload']\n",
    "    image_file = extract_file_name(image_file)\n",
    "    \n",
    "    for gi in range(gen_number):\n",
    "        source_image_path = Path(path_to_folder) / source_folder / image_file\n",
    "        target_image_path = constract_target_image_path(path_to_folder, target_folder, image_file, gi)\n",
    "        target_json_path = constract_target_json_path(path_to_folder, target_folder, image_file, gi)\n",
    "    \n",
    "        if not Path(source_image_path).exists() or not Path(source_image_path).is_file():\n",
    "            print(f'file {str(source_image_path)} does not exist!')\n",
    "            return\n",
    "   \n",
    "        img = cv2.imread(source_image_path)\n",
    "\n",
    "        for annotation in writng_info['annotations']:\n",
    "            polygons = []\n",
    "            fill_info = []\n",
    "                \n",
    "            for result in annotation['result']:\n",
    "\n",
    "                converted_coordinates = convert_coordinates(result['value']['x'], result['value']['y'],result['value']['width'], result['value']['height'], result['original_height'], result['original_width'])\n",
    "                fill_info.append({'coords':converted_coordinates, 'type':result['value']['rectanglelabels'][0]})\n",
    "                polygons.append([converted_coordinates['x'], converted_coordinates['y'], converted_coordinates['x'] + converted_coordinates['width'], converted_coordinates['y'] + converted_coordinates['height']])\n",
    "\n",
    "            filled_image = erase_polygons(img, polygons)\n",
    "            filled_image, fields = fill_documents(filled_image,source_image_path, fill_info)\n",
    "            transformed_image = apply_transform(filled_image)\n",
    "\n",
    "            with open(str(target_json_path), \"w\") as file:\n",
    "                json.dump(fields, file, ensure_ascii=False)\n",
    "\n",
    "           \n",
    "        cv2.imwrite(target_image_path, transformed_image)\n",
    "        \n"
   ]
  },
