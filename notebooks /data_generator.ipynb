    "from PIL import Image, ImageDraw, ImageFont\n",
    "from pathlib import Path\n",
    "from collections import defaultdict\n",
    "\n",
    "current_dir = Path.cwd()\n",
    "font_file = current_dir.parent / 'fonts' / 'Arial.ttf'\n",
    "\n",
    "def fill_documents(image,\n",
    "                    source_image_path,\n",
    "                        fill_info,\n",
    "                            font_path=font_file,\n",
    "                                font_size=30, color=(0, 0, 0)):\n",
    "\n",
    "    image = Image.fromarray(image)\n",
    "    draw = ImageDraw.Draw(image)\n",
    "\n",
    "    fields = defaultdict(list)\n",
    "    inn_nums = []\n",
    "\n",
    "    for f_item in fill_info:\n",
    "\n",
    "        # print(f'>>>>>>  {f_item['type']} >>>>>>>>>>>>>')\n",
    "        \n",
    "        if f_item['type'].startswith('inn_'):\n",
    "            val = synth_gen_mapping['inn']()\n",
    "            inn_nums.append((f_item['type'], val))\n",
    "        elif not f_item['type'].startswith('inn_'):\n",
    "            val = synth_gen_mapping[f_item['type']]()\n",
    "            fields[f_item['type']].append(val)\n",
    "    \n",
    "        try:\n",
    "            if font_path:\n",
    "                font = ImageFont.truetype(font_path, font_size)\n",
    "            else:\n",
    "                font = ImageFont.load_default()\n",
    "        except Exception as e:\n",
    "            print(f\"Ошибка при загрузке шрифта: {e}. Используется шрифт по умолчанию.\")\n",
    "            font = ImageFont.load_default()\n",
    "\n",
    "        x = int(f_item['coords']['x'])\n",
    "        y = int(f_item['coords']['y'])\n",
    "        # height = int(f_item['coords']['height'])\n",
    "\n",
    "        draw.text((x, y), val, font=font, fill=color)\n",
    "\n",
    "    ordered = get_in_order(inn_nums)\n",
    "\n",
    "    fields['inn'] = ordered\n",
    "\n",
    "    return np.asarray(image), fields\n"
   ]
