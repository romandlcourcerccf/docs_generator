    "import numpy as np\n",
    "from typing import List, Tuple, Any\n",
    "import cv2\n",
    "\n",
    "\n",
    "def erase_polygons(image, polygons: List[Tuple[int]]) -> Any:\n",
    "\n",
    "    img = image.copy()\n",
    "\n",
    "    for polygon in polygons:\n",
    "        x1, y1, x2, y2 = polygon[0], polygon[1], polygon[2], polygon[3]\n",
    "        pts = np.array([[x1, y1], [x2, y1], [x2, y2], [x1, y2]], dtype=np.int32)\n",
    "        mask = np.zeros(img.shape[:2], dtype=np.uint8)\n",
    "        cv2.fillPoly(mask, [pts], 100)\n",
    "        # img = cv2.inpaint(img, mask, inpaintRadius=5, flags=cv2.INPAINT_TELEA)\n",
    "        img = cv2.inpaint(img, mask, inpaintRadius=5, flags=cv2.INPAINT_NS)\n",
    "        \n",
    "    return img\n"
   ]
